[Unit]
Description=Device firmware update agent
Wants=bsp-data.service
After=bsp-data.service systemd-networkd.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
ExecStart=/usr/libexec/device-manager/fwctld-start
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
