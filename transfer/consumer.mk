DM_TRANSFER_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
DM_TRANSFER_CLIENT := $(DM_TRANSFER_DIR)/build/libdm-transfer.a
DM_TRANSFER_SERVER := $(DM_TRANSFER_DIR)/build/libdm-transfer-server.a
DM_TRANSFER_INCLUDE := -I$(DM_TRANSFER_DIR)/include
DM_TRANSFER_CLIENT_DEPS := $(wildcard $(DM_TRANSFER_DIR)/src/*.c $(DM_TRANSFER_DIR)/src/*.h $(DM_TRANSFER_DIR)/include/dm/*.h) $(DM_TRANSFER_DIR)/Makefile
$(DM_TRANSFER_CLIENT): $(DM_TRANSFER_CLIENT_DEPS)
	$(MAKE) -C $(DM_TRANSFER_DIR) client CC="$(CC)" AR="$(AR)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(CFLAGS)"
$(DM_TRANSFER_SERVER): $(DM_TRANSFER_CLIENT_DEPS)
	$(MAKE) -C $(DM_TRANSFER_DIR) server CC="$(CC)" AR="$(AR)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(CFLAGS)"
